# Parámetros de la pila de CloudFormation que usa infra/ec2/desplegar.sh (formato Clave=Valor,
# sin comillas ni comentarios al final de la línea).
# VpcId y PublicSubnet vacíos: se usan la VPC por defecto de la cuenta y una de sus subredes en
# una zona donde exista el tipo de instancia.

# t3.micro o t2.micro, el que sea elegible (capa gratuita o créditos) en la cuenta y la región.
InstanceType=t3.micro

# Quién puede consultar la API (los demás equipos) y quién puede entrar por SSH (los runners de
# GitHub no tienen IP fija; el acceso exige la llave privada).
ApiClientCidr=0.0.0.0/0
SshClientCidr=0.0.0.0/0

VpcId=
PublicSubnet=
