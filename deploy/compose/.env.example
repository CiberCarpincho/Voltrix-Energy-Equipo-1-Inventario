# Copiar como .env junto a compose.yaml y completar. El .env nunca se sube al repositorio.
# En la EC2 se crea una sola vez en la carpeta del despliegue (por defecto ~/voltrix-inventario);
# el pipeline de CD no lo modifica.

# --- PostgreSQL (contenedor db y API) ---------------------------------------------------
# Si el volumen pgdata ya existe, debe ser la contraseña con la que se inicializó.
POSTGRES_PASSWORD=

# --- API --------------------------------------------------------------------------------
# Puerto publicado en el host. Dentro de la red de Docker la API escucha en 8080.
API_PUERTO_HOST=8080

# --- Solo desarrollo (no hace falta en la EC2) -------------------------------------------
# Puerto de PostgreSQL en localhost (lo publica compose.override.yaml).
POSTGRES_PUERTO_HOST=5433
